{
  "name": "claude-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Claude Code の並列セッションを一覧する呼び出し盤（ローカル専用）",
  "scripts": {
    "start": "node server.mjs",
    "restart": "lsof -ti tcp:${PORT:-4317} -sTCP:LISTEN | xargs kill 2>/dev/null; sleep 1; node server.mjs",
    "hooks:install": "node install-hooks.mjs",
    "hooks:remove": "node install-hooks.mjs --remove",
    "usage:install": "node install-usage.mjs",
    "usage:remove": "node install-usage.mjs --remove"
  },
  "repository": { "type": "git", "url": "https://github.com/tai-sho/claude-dashboard.git" },
  "engines": { "node": ">=20" }
}
